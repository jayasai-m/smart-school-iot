{
  "buildCommand": "cd smart-school-iot/frontend && npm install && npm run build",
  "outputDirectory": "smart-school-iot/frontend/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
