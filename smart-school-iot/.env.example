# ==========================================
# SmartSchoolIoT Environment Configuration
# ==========================================

# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# MySQL Database Configuration (Workbench Compatible)
DATABASE_URL=mysql+pymysql://root:abc123@localhost:3306/smart_school_iot

# JWT Security
SECRET_KEY=smartschooliot_super_secret_jwt_key_2026_gov_portal
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Upload Directory
UPLOAD_DIR=uploads

# Hardware Connection Timeout (seconds without sensor ping before marking Disconnected)
HARDWARE_TIMEOUT_SECONDS=60

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

# Firebase Configuration (Optional / Plug-and-play Realtime Database)
FIREBASE_DATABASE_URL=
FIREBASE_CREDENTIALS_PATH=
